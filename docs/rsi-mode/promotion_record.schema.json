{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/praxist-rsi/promotion_record.schema.json",
  "title": "PRAXIST-RSI promotion record",
  "description": "Append-only record for one candidate considered for promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "candidate_version",
    "parent_version",
    "generation",
    "created_at",
    "metric",
    "protocol",
    "diff",
    "decision",
    "approval"
  ],
  "properties": {
    "record_version": {
      "type": "integer",
      "const": 1
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "parent_version": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "direction", "baseline", "parent"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "direction": {
          "type": "string",
          "enum": ["maximize", "minimize"]
        },
        "baseline": {
          "type": "number"
        },
        "parent": {
          "type": "number"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "failures", "evaluator_manifest_sha256"],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluator_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "files_changed", "summary"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files_changed": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "string",
      "enum": ["promote", "reject", "hold"]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "approved_at", "notes"],
      "properties": {
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
